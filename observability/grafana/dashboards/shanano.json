{
  "title": "Shanano",
  "uid": "shanano",
  "tags": ["shanano"],
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "title": "Songs Uploaded (rate)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(shanano_songs_uploaded_total[1m]))",
          "legendFormat": "uploads/sec"
        }
      ]
    },
    {
      "title": "Songs by Status",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "shanano_songs_by_status",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "title": "Songs Processed (rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "rate(shanano_songs_processed_total[5m])",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "title": "Processing Duration (p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(shanano_processing_duration_seconds_bucket[5m]))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "title": "HTTP Requests (rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 8 },
      "targets": [
        {
          "expr": "rate(shanano_http_requests_total[5m])",
          "legendFormat": "{{method}} {{endpoint}}"
        }
      ]
    },
    {
      "title": "HTTP Request Duration (p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(shanano_http_request_duration_seconds_bucket[5m]))",
          "legendFormat": "{{method}} {{endpoint}}"
        }
      ]
    }
  ]
}
